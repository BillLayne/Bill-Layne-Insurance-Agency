/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/img/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/auto-center/images/*
  Cache-Control: public, max-age=31536000, immutable

/auto-center/free-vin-decoder-assets/app.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/auto-center/free-vin-decoder-assets/page.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/auto-center/free-vin-decoder-assets/auto-hero.jpeg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=6048000

/auto-center/free-vin-decoder-assets/ocr/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/blog/blogs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/bryson-layne/bryson-layne.vcf
  Content-Type: text/vcard; charset=utf-8
  Content-Disposition: attachment; filename="bryson-layne.vcf"
  Cache-Control: public, max-age=3600

# Internal tools and templates: crawlable (so the noindex is seen) but never indexed.
/templates/*
  X-Robots-Tag: noindex, nofollow
/bill-layne-newsletter/*
  X-Robots-Tag: noindex, nofollow
